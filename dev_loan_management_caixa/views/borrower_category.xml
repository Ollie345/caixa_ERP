<odoo>

    <record id="view_borrower_category_tree" model="ir.ui.view">
        <field name="name">view.borrower.category.tree</field>
        <field name="model">borrower.category</field>
        <field name="arch" type="xml">
            <list string="Borrower category tree" editable="bottom">
                <field name="name"/>
                <field name="loan_request_per_year"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_borrower_category_form" model="ir.ui.view">
        <field name="name">view.borrower.category.form</field>
        <field name="model">borrower.category</field>
        <field name="arch" type="xml">
            <form string="Borrower Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="loan_request_per_year"/>
                            <field name="is_default"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_borrower_category" model="ir.actions.act_window">
        <field name="name">Borrower category</field>
        <field name="res_model">borrower.category</field>
        <field name="view_mode">list,form</field>
    </record>

	<!--  Menu Items-->
    <menuitem name="Borrower category" id="menu_borrower_category" parent="dev_loan_management_caixa.menu_dev_loan_configration" action="action_borrower_category" sequence="4"/>
</odoo>