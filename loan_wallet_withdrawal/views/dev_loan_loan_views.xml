<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_loan_loan_form_withdrawal" model="ir.ui.view">
        <field name="name">dev.loan.loan.form.withdrawal</field>
        <field name="model">dev.loan.loan</field>
        <field name="inherit_id" ref="dev_loan_management_caixa.view_dev_loan_loan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_installment']" position="after">
                <button name="action_view_withdrawals" type="object" class="oe_stat_button" icon="fa-money" context="{'search_default_loan_id': id}" invisible="withdrawal_count == 0">
                    <field name="withdrawal_count" widget="statinfo" string="Withdrawals"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
