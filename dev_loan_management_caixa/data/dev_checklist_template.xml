<odoo>
    <!-- =================== Payday Loans =================== -->
    <record id="template_payday_line1" model="dev.checklist.template.line">
        <field name="type_id" ref="loan_type_payday"/>
        <field name="name">BVN and employer verification</field>
    </record>

    <record id="template_payday_line2" model="dev.checklist.template.line">
        <field name="type_id" ref="loan_type_payday"/>
        <field name="name">Salary confirmation and payslip validation</field>
    </record>

    <record id="template_payday_line3" model="dev.checklist.template.line">
        <field name="type_id" ref="loan_type_payday"/>
        <field name="name">Employment confirmation via partner organization portal</field>
    </record>

    <record id="template_payday_line4" model="dev.checklist.template.line">
        <field name="type_id" ref="loan_type_payday"/>
        <field name="name">Prepare 1 % fee invoice for payment</field>
    </record>

    <record id="template_payday_line5" model="dev.checklist.template.line">
        <field name="type_id" ref="loan_type_payday"/>
        <field name="name">Employer risk rating review</field>
