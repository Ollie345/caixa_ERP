<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action: Export Images for Products (only if product module is installed) -->
    <record id="action_export_product_images" model="ir.actions.server" noupdate="1">
        <field name="name">Export Images</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Export Images',
    'res_model': 'image.export.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'active_model': 'product.template',
        'active_ids': records.ids,
    }
}
        </field>
    </record>

