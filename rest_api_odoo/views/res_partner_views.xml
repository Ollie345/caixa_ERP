<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited partner form view for wallet information -->
    <record id="view_partner_form_wallet" model="ir.ui.view">
        <field name="name">view.partner.form.wallet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add smart button for wallet payments -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_wallet_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="not wallet_account_number">
                    <field name="wallet_payment_count" widget="statinfo" string="Wallet Payments"/>
                </button>
            </xpath>

            <!-- Add wallet information page after internal notes -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Wallet Information" name="wallet_info">
                    <!-- Show wallet details if exists -->
                    <group string="Wallet Details" invisible="not wallet_account_number">
                        <group name="wallet_left">
                            <field name="wallet_account_number" readonly="1"/>
                            <field name="wallet_tier" readonly="1"/>
                            <field name="wallet_status" readonly="1"/>
                        </group>
                        <group name="wallet_right">
                            <field name="wallet_created_date" readonly="1"/>
                            <field name="baas_wallet_id" readonly="1"/>
                            <field name="wallet_balance" readonly="1"/>
                            <field name="wallet_currency_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                        <group name="wallet_sync">
                            <field name="wallet_balance_last_updated" readonly="1"/>
                            <button name="action_refresh_wallet_balance"
                                    type="object"
                                    string="Refresh Balance"
                                    class="oe_link"
                                    icon="fa-refresh"/>
                        </group>
                    </group>

                    <!-- Show Tier 1 create button if wallet doesn't exist -->
                    <group string="Create Wallet" invisible="wallet_account_number">
                        <div class="alert alert-info" role="alert">
                            <p>
                                <strong>Create a Tier Two wallet for this partner.</strong>
                            </p>
                            <p>Requirements: BVN and Phone Number.</p>
                        </div>
                        <button name="action_create_wallet_tier_two"
                                type="object"
                                string="Create Tier Two Wallet"
                                class="btn-primary"
                                icon="fa-credit-card"/>
                    </group>

