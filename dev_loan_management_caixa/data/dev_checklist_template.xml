        <field name="type_id" ref="loan_type_payday"/>
        <field name="name">Debt-to-income ratio and repayment capacity check</field>
    </record>

    <record id="template_payday_line7" model="dev.checklist.template.line">
        <field name="type_id" ref="loan_type_payday"/>
        <field name="name">Approval or rejection with comments</field>
