<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_image_import_wizard_form" model="ir.ui.view">
        <field name="name">image.import.wizard.form</field>
        <field name="model">image.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Images">
                <group string="Upload Export File" invisible="state != 'upload'">
                    <field name="import_file" filename="filename" required="1"/>
                    <field name="filename" invisible="1"/>
                    <field name="state" invisible="1"/>
                </group>
                
                <group string="Import Options" invisible="state == 'upload'">
                    <field name="match_by" required="1"/>
                </group>
                
                <group string="Export Information" invisible="state == 'upload'">
                    <field name="export_info" widget="text" readonly="1" nolabel="1"/>
                </group>
                
                <group string="Preview" invisible="state == 'upload'">
                    <field name="preview_data" widget="text" readonly="1" nolabel="1"/>
                </group>
                
                <footer>
                    <button name="action_import" string="Import Images" 
                            type="object" class="btn-primary" 
                            invisible="state == 'upload'"/>
                    <button string="Close" class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_image_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Images</field>
        <field name="res_model">image.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
