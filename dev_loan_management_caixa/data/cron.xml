<?xml version="1.0"?>
<odoo>
    <record id="ir_cron_installment_reminder_action" model="ir.cron">
        <field name="name">Loan Installment Reminder</field>
        <field name="model_id" ref="model_dev_loan_installment"/>
        <field name="state">code</field>
        <field name="code">model.loan_installment_reminder()</field>
        <field name="active" eval="True"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!--            <field name="numbercall">-1</field>-->
    </record>

    <record id="cron_compute_penalties" model="ir.cron">
        <field name="name">Compute Loan Penalties</field>
        <field name="model_id" ref="model_dev_loan_installment"/>
        <field name="state">code</field>
        <field name="code">model.cron_apply_penalty()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
<!--        <field name="numbercall">-1</field>-->
        <field name="active">True</field>
    </record>
</odoo>
