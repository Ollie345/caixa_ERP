<odoo>

    <!--              PAYDAY LOAN TYPE                 -->
    <record id="loan_type_payday" model="dev.loan.type">
        <field name="name">Payday Loan</field>

        <!-- Required numeric fields -->
        <field name="rate">5</field>
        <field name="loan_amount">50000</field>
        <field name="loan_term_by_month">1</field>

        <!-- Interest Settings -->
        <field name="is_interest_apply">True</field>
        <field name="interest_mode">flat</field>
        <field name="none_interest_month">0</field>

        <!-- Add ALL required proofs -->
        <field name="proof_ids" eval="[(6,0,[
            ref('dev_loan_management_caixa.dev_loan_proof_aadhar'),
            ref('dev_loan_management_caixa.dev_loan_proof_pan'),
            ref('dev_loan_management_caixa.dev_loan_proof_light_bill')
        ])]"/>

        <!-- Add ALL borrower categories -->
        <field name="borrower_category_ids" eval="[(6,0,[
            ref('dev_loan_management_caixa.borrower_category_business'),
            ref('dev_loan_management_caixa.borrower_category_shopkeeper'),
            ref('dev_loan_management_caixa.borrower_category_job')
        ])]"/>

        <!-- Accounting & journals -->
        <field name="loan_account_id" ref="account.1_prepaid_expenses"/>
        <field name="interest_account_id" ref="account.1_deferred_revenue"/>
        <field name="installment_account_id" ref="account.1_current_assets"/>

        <field name="disburse_journal_id" ref="account.1_purchase"/>
        <field name="loan_payment_journal_id" ref="account.1_sale"/>
    </record>


    <!--              SME LOAN TYPE                    -->
    <record id="loan_type_sme" model="dev.loan.type">
        <field name="name">SME Loan</field>
        <field name="rate">10</field>
        <field name="loan_amount">200000</field>
        <field name="loan_term_by_month">6</field>

        <field name="is_interest_apply">True</field>
        <field name="interest_mode">reducing</field>

        <field name="proof_ids" eval="[(6,0,[
            ref('dev_loan_management_caixa.dev_loan_proof_aadhar'),
            ref('dev_loan_management_caixa.dev_loan_proof_pan'),
            ref('dev_loan_management_caixa.dev_loan_proof_light_bill')
        ])]"/>

        <field name="borrower_category_ids" eval="[(6,0,[
            ref('dev_loan_management_caixa.borrower_category_business')
        ])]"/>

        <field name="loan_account_id" ref="account.1_prepaid_expenses"/>
        <field name="interest_account_id" ref="account.1_deferred_revenue"/>
        <field name="installment_account_id" ref="account.1_current_assets"/>

        <field name="disburse_journal_id" ref="account.1_purchase"/>
        <field name="loan_payment_journal_id" ref="account.1_sale"/>
    </record>


    <!--              LPO LOAN TYPE                    -->
    <record id="loan_type_lpo" model="dev.loan.type">
        <field name="name">LPO Financing</field>
        <field name="rate">8</field>
        <field name="loan_amount">1000000</field>
        <field name="loan_term_by_month">3</field>

        <field name="is_interest_apply">True</field>
        <field name="interest_mode">flat</field>

        <field name="proof_ids" eval="[(6,0,[
            ref('dev_loan_management_caixa.dev_loan_proof_aadhar'),
            ref('dev_loan_management_caixa.dev_loan_proof_pan'),
            ref('dev_loan_management_caixa.dev_loan_proof_light_bill')
        ])]"/>

        <field name="borrower_category_ids" eval="[(6,0,[
            ref('dev_loan_management_caixa.borrower_category_shopkeeper')
        ])]"/>

        <field name="loan_account_id" ref="account.1_prepaid_expenses"/>
        <field name="interest_account_id" ref="account.1_deferred_revenue"/>
        <field name="installment_account_id" ref="account.1_current_assets"/>

        <field name="disburse_journal_id" ref="account.1_purchase"/>
        <field name="loan_payment_journal_id" ref="account.1_sale"/>
    </record>

</odoo>
