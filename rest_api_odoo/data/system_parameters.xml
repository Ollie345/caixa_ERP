<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- BaaS API Configuration Parameters -->
        <record id="baas_base_url" model="ir.config_parameter">
            <field name="key">baas.base_url</field>
            <field name="value">https://baas.dev.getrova.co.uk</field>
        </record>
        
        <record id="baas_client_id" model="ir.config_parameter">
            <field name="key">baas.client_id</field>
            <field name="value"></field>
        </record>
        
        <record id="baas_client_secret" model="ir.config_parameter">
            <field name="key">baas.client_secret</field>
            <field name="value"></field>
        </record>
    </data>
</odoo>
